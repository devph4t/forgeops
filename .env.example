# Copy this file to .env and adjust for your machine.
# Read by everything in ./_scripts/.

# forgeops environment name (Kustomize overlay name / Helm values folder name
# under kustomize/overlay/<ENV> and helm/<ENV>)
ENV=local

# Kubernetes namespace the platform is deployed into
K8S_NAMESPACE=ping-local

# Deployment size: single-instance | small | medium | large
K8S_SIZE=single-instance

# Base FQDN used for ingress hosts (add it to /etc/hosts pointing at the
# minikube IP, or use `minikube tunnel` - startup.sh prints the exact steps)
DOMAIN=ping-local.test.bbl

# --- optional, uncomment to override defaults ---

# Minikube profile name (default: forgeops-<ENV>)
#MINIKUBE_PROFILE=forgeops-local
# Minikube VM driver (default: docker)
#MINIKUBE_DRIVER=docker
# Minikube resource sizing (only applied when the profile is first created)
#MINIKUBE_CPUS=4
#MINIKUBE_MEMORY=8000mb
#MINIKUBE_DISK=40g

# Ingress controller forgeops prereqs installs: traefik | nginx | haproxy
#INGRESS=traefik

# Install cluster prereqs (cert-manager, ingress, secret-agent) via
# _scripts/prereqs-manual.sh instead of `forgeops prereqs`. Use this if your
# network policy blocks some of the chart repo hosts `forgeops prereqs`
# needs in one go - prereqs-manual.sh fetches+installs each one separately
# and supports a fully offline install (see: ./_scripts/prereqs-manual.sh -h)
#PREREQS_MANUAL=true

# Where prereqs-manual.sh caches/reads downloaded chart files
# (default: _scripts/.chart-cache)
#CHARTS_DIR=

# How startup.sh/restart.sh publish host ports 80/443 to the cluster
# ingress when minikube's IP isn't directly reachable (typical on WSL2 /
# Docker Desktop): docker (default, via two small alpine/socat containers)
# or kubectl-port-forward (no extra image, but tied to a background
# process). Switch to kubectl-port-forward if docker fails with something
# like "Error response from daemon: ... /forwards/expose returned
# unexpected status 500" - a Docker Desktop port-forwarder bug.
#INGRESS_ACCESS_MODE=docker
